{
  "keyframes": {
    "tp-curtain-cover": "0%{transform:translateY(calc(100% + 44px))}to{transform:translate(0)}",
    "tp-curtain-lift": "0%{transform:translate(0)}to{transform:translateY(calc(-100% - 44px))}",
    "tp-curtain-rest": "to{visibility:hidden}",
    "tp-runner-x": "0%{translate:-40%}to{translate:calc(min(44rem,86vw)/1.5625)}",
    "tp-print-step": "0%{opacity:0;scale:.4}14%{opacity:.7;scale:1.08}26%{scale:1}70%{opacity:.7}to{opacity:0}",
    "tp-runner-leg-a": "0%{rotate:24deg}to{rotate:-22deg}",
    "tp-runner-leg-b": "0%{rotate:-22deg}to{rotate:24deg}",
    "tp-runner-bob": "0%{translate:0}to{translate:0 -6px}",
    "tp-runner-wag": "0%{rotate:-16deg}to{rotate:14deg}",
    "tp-runner-ear": "0%{rotate:0deg}to{rotate:8deg}",
    "tp-hold-still": "0%,to{overflow-y:hidden}",
    "tp-menu-in": "0%{clip-path:circle(0% at calc(100% - 3rem) 2rem)}to{clip-path:circle(150% at calc(100% - 3rem) 2rem)}",
    "tp-menu-out": "0%{clip-path:circle(150% at calc(100% - 3rem) 2rem)}to{clip-path:circle(0% at calc(100% - 3rem) 2rem)}",
    "tp-menu-backdrop-out": "to{opacity:0}",
    "tp-menu-link": "0%{opacity:0;transform:translateY(1.2rem)rotate(-2deg)}",
    "tp-twinkle": "0%,to{opacity:.35;transform:scale(.8)rotate(0)}50%{opacity:1;transform:scale(1.1)rotate(20deg)}",
    "tp-float": "0%,to{transform:translateY(0)rotate(0)}50%{transform:translateY(-8px)rotate(8deg)}",
    "tp-stamp-thump": "0%{opacity:0;transform:scale(1.25)rotate(-22deg)}60%{opacity:1;transform:scale(.94)rotate(-8deg)}to{opacity:1;transform:scale(1)rotate(-10deg)}",
    "tp-sun-set": "0%{translate:0 -60%}to{translate:0 40%}",
    "tp-sunrise": "0%{opacity:0;translate:-50% 16%}",
    "tp-peek": "0%{translate:0 100%}",
    "tp-pop-up": "0%{opacity:.6;translate:0 108%;scale:.92}65%{opacity:1;scale:1.04}to{opacity:1;translate:0;scale:1}",
    "tp-door-open": "0%{transform:rotateY(0)}to{transform:rotateY(var(--door-open))}",
    "tp-msg-in": "0%{opacity:0;translate:0 .8rem;scale:.92}",
    "tp-dot": "0%,60%,to{translate:0}30%{translate:0 -.35rem}",
    "tp-stamp-in": "0%{opacity:0;scale:1.7;rotate:calc(var(--tilt) - 16deg)}55%{opacity:.95;scale:.93}75%{scale:1.03}to{opacity:.9;scale:1;rotate:var(--tilt)}",
    "tp-house-open": "0%{transform:rotateY(0)}to{transform:rotateY(-102deg)}",
    "tp-breathe": "50%{scale:1 1.014}",
    "tp-blink-open": "0%,92%,97%,to{opacity:1}94.5%{opacity:0}",
    "tp-blink-shut": "0%,92%,97%,to{opacity:0}94.5%{opacity:1}",
    "tp-ear-twitch": "0%,84%,to{rotate:0deg}87%{rotate:-11deg}90%{rotate:5deg}93%{rotate:-2deg}",
    "tp-doodle-hop": "40%{rotate:12deg;scale:1.35}",
    "tp-print-bound": "0%{opacity:0;animation-timing-function:cubic-bezier(.2,.7,.3,1);translate:0 1.6rem;scale:.9}42%{opacity:1;animation-timing-function:cubic-bezier(.5,0,.7,.4);translate:0 -.4rem;scale:.98 1.03}68%{animation-timing-function:cubic-bezier(.3,0,.3,1);translate:0;scale:1.03 .97}to{opacity:1;translate:0;scale:1}",
    "tp-paw-pat": "0%{opacity:0;animation-timing-function:cubic-bezier(.4,0,.7,.6);transform:translateY(-1.2rem)rotate(-16deg)scale(1.15)}32%{opacity:.92;animation-timing-function:cubic-bezier(.3,0,.3,1);transform:translateY(.12rem)rotate(-6deg)scale(1.06,.88)}52%{opacity:.92;animation-timing-function:cubic-bezier(.4,0,.8,.6);transform:translateY(0)rotate(-6deg)scale(1)}to{opacity:0;transform:translateY(-1rem)rotate(6deg)scale(1.04)}",
    "tp-letter-fold": "55%{opacity:.7;transform:perspective(1100px)rotateX(62deg)scale(.8)}to{opacity:0;transform:perspective(1100px)rotateX(80deg)scale(.35)translateY(30%)}",
    "tp-env-in": "0%{opacity:0;scale:.4}",
    "tp-flap": "0%{transform:scaleY(-1)}",
    "tp-env-post": "0%{translate:-50%;scale:1}35%{translate:-50% -1.2rem;scale:.92}to{translate:-50% 12.5rem;scale:.55}",
    "tp-box-up": "to{translate:-50%}",
    "tp-flag": "to{rotate:0deg}",
    "tp-sent-in": "0%{opacity:0;transform:translateY(1rem)scale(.96)}",
    "tp-tag-swing": "0%{rotate:calc(-7deg * var(--swing,1));opacity:0}12%{opacity:1}30%{rotate:calc(4deg * var(--swing,1))}50%{rotate:calc(-2.2deg * var(--swing,1))}70%{rotate:calc(1deg * var(--swing,1))}86%{rotate:calc(-.4deg * var(--swing,1))}to{rotate:0deg}",
    "tp-tag-nudge": "25%{rotate:calc(1.6deg * var(--swing,1))}55%{rotate:calc(-.9deg * var(--swing,1))}80%{rotate:calc(.3deg * var(--swing,1))}",
    "tp-poster-in": "0%{opacity:0;transform:translateY(-1.5rem)rotate(3deg)}",
    "tp-step-in": "0%{opacity:0;translate:0 1.25rem;rotate:1.5deg}",
    "tp-plane-bob": "50%{translate:0 -6px;rotate:-3deg}"
  },
  "usage": {
    ".tp-curtain[data-state=intro]": "0s linear 1.04s forwards tp-curtain-rest",
    ".tp-curtain[data-state=intro] .tp-curtain__blanket": ".48s cubic-bezier(.65,0,.3,1) .56s forwards tp-curtain-lift",
    ".tp-curtain[data-state=covering] .tp-curtain__blanket": ".3s cubic-bezier(.22,1,.36,1) both tp-curtain-cover",
    ".tp-curtain[data-state=lifting] .tp-curtain__blanket": ".46s cubic-bezier(.65,0,.3,1) both tp-curtain-lift",
    ".tp-curtain:not([data-state=idle]) .tp-curtain__runner": "1.15s cubic-bezier(.32,.1,.4,1) both tp-runner-x",
    ".tp-curtain:not([data-state=idle]) .tp-curtain__print": "1s ease-out both tp-print-step",
    ".tp-curtain:not([data-state=idle]) .tp-runner__leg--fn,.tp-curtain:not([data-state=idle]) .tp-runner__leg--bf": ".32s ease-in-out infinite alternate tp-runner-leg-a",
    ".tp-curtain:not([data-state=idle]) .tp-runner__leg--ff,.tp-curtain:not([data-state=idle]) .tp-runner__leg--bn": ".32s ease-in-out infinite alternate tp-runner-leg-b",
    ".tp-curtain:not([data-state=idle]) .tp-runner__body": ".16s ease-in-out infinite alternate tp-runner-bob",
    ".tp-curtain:not([data-state=idle]) .tp-runner__tail": ".22s ease-in-out infinite alternate tp-runner-wag",
    ".tp-curtain:not([data-state=idle]) .tp-runner__ear": ".16s ease-in-out infinite alternate tp-runner-ear",
    "html:has(>body>.tp-curtain[data-state=intro])": "1.04s tp-hold-still",
    "html[data-curtain]": "7s tp-hold-still",
    ".tp-menu[open]": "tp-menu-in .5s var(--ease-snap)",
    ".tp-menu[data-closing]": "tp-menu-out .42s var(--ease-snap) forwards",
    ".tp-menu[data-closing]::backdrop": ".42s forwards tp-menu-backdrop-out",
    ".tp-menu[open] .tp-menu-link": "tp-menu-link .55s var(--ease-pounce) both",
    ".tp-twinkle": "3.2s ease-in-out infinite tp-twinkle",
    ".tp-polaroid .tp-gone-stamp": "linear both tp-stamp-thump",
    ".tp-gone-stamp": "none!important",
    ".tp-horizon__sun": "none!important",
    ".tp-hero__sun": "tp-sunrise 2.6s var(--ease-silk) both",
    ".tp-lineup__pup": "tp-peek .75s var(--ease-pounce) backwards",
    ".tp-lineup__pup[data-state=pop] .tp-lineup__photo": "tp-pop-up .58s var(--ease-pounce) both",
    ".tp-door__leaf": "none!important",
    ".tp-meet[data-pinned] .tp-door__leaf": "none",
    ".tp-msg-group>*": "tp-msg-in .5s var(--ease-pounce) both",
    ".tp-typing span": ".9s ease-in-out infinite tp-dot",
    ".tp-stamp": "none!important",
    ".tp-night__wonder": "3.4s ease-in-out infinite tp-float",
    ".tp-house__door": "none!important",
    "html[data-pup] .tp-house__door": "none",
    ".tp-basket__pup .pup-buddy:not([data-live])>svg": "3.8s ease-in-out infinite tp-breathe",
    ".tp-basket__pup .pup-buddy:not([data-live]) [data-p=open]": "6.2s infinite tp-blink-open",
    ".tp-basket__pup .pup-buddy:not([data-live]) [data-p=shut]": "6.2s infinite tp-blink-shut",
    ".tp-basket__pup .pup-buddy:not([data-live]) [data-p=earR]": "7.4s ease-in-out 2.2s infinite tp-ear-twitch",
    ".tp-sketch:is(:hover,:focus-visible) .tp-sketch__doodle": "tp-doodle-hop .5s var(--ease-pounce)",
    ".tp-wall__item[data-armed][data-revealed] .tp-polaroid": "tp-print-bound .62s var(--d) backwards",
    ".tp-wall__item[data-armed][data-revealed] .tp-wall__paw": "tp-paw-pat .7s calc(var(--d) + .2s) both",
    ".tp-post[data-phase=sealing] .tp-letterform,.tp-post[data-phase=posting] .tp-letterform": "tp-letter-fold .65s var(--ease-snap) forwards",
    ".tp-post__envelope": "tp-env-in .45s .3s var(--ease-pounce) both",
    ".tp-post__flap": ".3s ease-in .55s both tp-flap",
    ".tp-post[data-phase=posting] .tp-post__envelope": "tp-env-post .85s var(--ease-snap) forwards",
    ".tp-post[data-phase=posting] .tp-post__box": "tp-box-up .5s var(--ease-pounce) forwards",
    ".tp-post[data-phase=posting] .tp-post__flag": "tp-flag .4s .75s var(--ease-pounce) forwards",
    ".tp-post__sent": "tp-sent-in .55s var(--ease-pounce) both",
    ".tp-post *,.tp-post__sent": "none!important",
    ".tp-tag[data-revealed]": "tp-tag-swing 1.7s var(--ease-silk) both",
    ".tp-tag[data-revealed]:hover": "tp-tag-nudge 1.3s var(--ease-silk)",
    ".tp-tag,.tp-tag[data-revealed],.tp-tag[data-revealed]:hover": "none",
    ".tp-poster": "none",
    ".tp-journeys[data-ready] .tp-step": "tp-step-in .55s var(--ease-pounce) both",
    ".tp-postcard__plane": "3.2s ease-in-out infinite tp-plane-bob"
  }
}